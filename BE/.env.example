# Copy this file to BE/.env and fill in the values marked REQUIRED. Never commit BE/.env.
# Every name below is read by the backend (BE/src/config/env.ts and the files named in the comments).

# ── Server ──
PORT=4000
# The address of the frontend, allowed by CORS.
CORS_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/archtime
# Only if mongodb+srv:// does not resolve on this machine: comma-separated DNS servers for Node to use.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# How many reverse proxies (nginx, a load balancer, a hosting platform) sit between the internet and this server: 1, 2, ...
# Leave unset or "false" when clients connect directly. The rate limits on sign-in and e-mail codes count per client IP,
# and Express can only see the real IP behind a proxy when this is set. Without it every visitor behind a proxy shares the
# proxy's address (so the per-IP limits, which are generous on purpose, are shared by everyone). Use the exact number of
# hops, not "true": with "true" a client can fake its address with an X-Forwarded-For header and dodge the per-IP limits.
# TRUST_PROXY=1

# ── Sign-in tokens ──
# REQUIRED. A long random string. Also encrypts the AI model API keys stored by an administrator unless LLM_SECRET_KEY is set.
JWT_SECRET=
JWT_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=7d
# Optional. Keys the stored hashes of the e-mailed verification codes (falls back to JWT_SECRET). Changing it makes pending codes stop working.
# OTP_PEPPER=

# ── Email (verification codes and password reset) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# REQUIRED: the server does not start without these three.
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ArchTime <you@example.com>"

# ── Sign in with GitHub (optional; leave empty to disable) ──
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# ── AI model used when no model has been added by an administrator (optional; see BE/src/infrastructure/llm/runtime.ts) ──
# LLM_PROVIDER=anthropic          # anthropic | gemini | openai-compatible
# LLM_MODEL=                     # required for openai-compatible; the others have a default
# LLM_BASE_URL=                   # required for openai-compatible, together with LLM_MODEL
# LLM_API_KEY=                    # openai-compatible (optional) and gemini (instead of GEMINI_API_KEY)
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# LLM_TIMEOUT_MS=180000
# LLM_EFFORT=medium               # anthropic: low | medium | high
# LLM_JSON_MODE=true              # openai-compatible: ask for a JSON object
# LLM_MAX_REFINE_FILES=
# LLM_MAX_MOVE_RATIO=
# Encrypts API keys of models added by an administrator (falls back to JWT_SECRET).
# LLM_SECRET_KEY=

# ── Mining (optional) ──
# MINING_BATCH_SIZE=
# MINING_MAX_CONCURRENT=
# Allow local paths as repository addresses. Tests and local development only: leave unset otherwise.
# ARCHTIME_ALLOW_LOCAL_REPOS=true
